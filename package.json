{
  "name": "aiviron",
  "version": "0.5.0",
  "type": "module",
  "description": "A shared project workspace for better AI-assisted development",
  "keywords": [
    "ai",
    "agents",
    "ai-workspace",
    "coding-agents",
    "developer-tools",
    "context-management",
    "cli",
    "handoff",
    "local-first"
  ],
  "license": "MIT",
  "author": "0xhumb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensp1re/aiviron.git"
  },
  "homepage": "https://github.com/ensp1re/aiviron#readme",
  "bugs": {
    "url": "https://github.com/ensp1re/aiviron/issues"
  },
  "files": [
    "bin/",
    "src/",
    "schemas/",
    "docs/workflow.md",
    "docs/continuity-spike.md",
    "docs/project-knowledge.md"
  ],
  "bin": {
    "aiviron": "bin/aiviron.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/environment-generator.test.mjs tests/continuity-spike.test.mjs tests/repository-context.test.mjs tests/continuation-workflow.test.mjs tests/harness-loop.test.mjs tests/schema-conformance.test.mjs tests/knowledge-docs.test.mjs",
    "test:knowledge": "node --test tests/knowledge-docs.test.mjs",
    "prepublishOnly": "npm test",
    "test:schemas": "node --test tests/schema-conformance.test.mjs",
    "aiviron": "node bin/aiviron.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
