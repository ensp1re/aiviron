{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiviron.dev/v1alpha1/memory-record.schema.json",
  "title": "Aiviron typed memory record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "id",
    "memoryType",
    "scope",
    "payload",
    "status",
    "provenance",
    "confidence",
    "validTime",
    "transactionTime",
    "sensitivity",
    "trust",
    "retention"
  ],
  "properties": {
    "apiVersion": { "const": "dev.aiviron/v1alpha1" },
    "kind": { "const": "MemoryRecord" },
    "id": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "memoryType": {
      "type": "string",
      "enum": ["working", "episodic", "semantic", "procedural", "decision", "failure", "preference", "tool"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project"],
      "properties": {
        "tenant": { "type": "string", "minLength": 1 },
        "project": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "workspace": { "type": "string", "minLength": 1 },
        "task": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "user": { "type": "string", "minLength": 1 }
      }
    },
    "payload": {
      "type": "object",
      "minProperties": 1
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "superseded", "expired"]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/evidenceRef" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "validTime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "transactionTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordedAt"],
      "properties": {
        "recordedAt": { "type": "string", "format": "date-time" },
        "supersededAt": { "type": "string", "format": "date-time" }
      }
    },
    "sensitivity": { "$ref": "common.schema.json#/$defs/sensitivity" },
    "trust": { "$ref": "common.schema.json#/$defs/trust" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legalHold"],
      "properties": {
        "ttlSeconds": { "type": "integer", "minimum": 1 },
        "legalHold": { "type": "boolean" }
      }
    },
    "supersedes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/opaqueId" },
      "uniqueItems": true
    },
    "supersededBy": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "embeddingRefs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/objectRef" }
    },
    "acceptedBy": { "$ref": "common.schema.json#/$defs/actor" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "properties": { "acceptedBy": { "$ref": "common.schema.json#/$defs/actor" } },
        "required": ["acceptedBy"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
      "then": {
        "properties": { "supersededBy": { "$ref": "common.schema.json#/$defs/opaqueId" } },
        "required": ["supersededBy"]
      }
    }
  ]
}
